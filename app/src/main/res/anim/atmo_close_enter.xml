<?xml version="1.0" encoding="utf-8"?>
<!-- M3 shared axis Z, back: the previous screen settles back from the viewer. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <alpha
        android:duration="260"
        android:fromAlpha="0.4"
        android:toAlpha="1"
        android:interpolator="@android:interpolator/linear" />
    <scale
        android:duration="400"
        android:fromXScale="1.06"
        android:fromYScale="1.06"
        android:toXScale="1"
        android:toYScale="1"
        android:pivotX="50%"
        android:pivotY="50%"
        android:interpolator="@interpolator/atmo_emphasized_decelerate" />
</set>
